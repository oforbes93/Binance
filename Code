# =========================
# Binance Market Share (LIVE + Historical) + Average Line
# - Reads your historical CSV
# - Upserts today's value using DefiLlama (Binance assets) + CoinGecko (total mcap)
# - Writes:
#     1) RAW canonical CSV (for future runs)
#     2) PRETTY CSV (nice headings + billions)
# - Plots last N days + horizontal average line over the plotted period
# =========================

import time
import json
from datetime import datetime
import requests
import pandas as pd
import matplotlib.pyplot as plt

import cloudscraper
from bs4 import BeautifulSoup

# =========================
# CONFIG (EDIT THESE)
# =========================
HISTORICAL_CSV = "binance_market_share_history.csv"          # your existing file
OUTPUT_RAW_CSV = "binance_market_share_history_raw.csv"      # canonical file for future runs
OUTPUT_PRETTY_CSV = "binance_market_share_history_pretty.csv"  # human-friendly file
DAYS_TO_PLOT = 365

# =========================
# 1) Fetch Binance assets today (DefiLlama page -> __NEXT_DATA__)
# =========================
def get_binance_assets_today_defillama():
    """
    Pulls today's Binance assets by summing currentTvlByChain from DefiLlama's Next.js payload.
    Returns float (USD).
    """
    url = "https://defillama.com/cex/binance-cex"

    scraper = cloudscraper.create_scraper()
    resp = scraper.get(url, timeout=30)
    resp.raise_for_status()

    soup = BeautifulSoup(resp.text, "html.parser")
    script_tag = soup.find("script", id="__NEXT_DATA__")
    if script_tag is None or not script_tag.string:
        raise RuntimeError("Could not find __NEXT_DATA__ (blocked or structure changed).")

    data = json.loads(script_tag.string)
    page_props = data.get("props", {}).get("pageProps", {})

    chains = page_props.get("currentTvlByChain")
    if chains is None:
        raise KeyError(f"'currentTvlByChain' not found. Keys: {list(page_props.keys())}")

    # Sum all chains = Binance total assets
    total_assets = float(sum(chains.values()))
    return total_assets

# =========================
# 2) Fetch total crypto market cap today (CoinGecko /global)
# =========================
def get_total_crypto_mcap_today_coingecko():
    url = "https://api.coingecko.com/api/v3/global"
    r = requests.get(url, timeout=20, headers={"Accept": "application/json"})
    r.raise_for_status()
    data = r.json()
    return float(data["data"]["total_market_cap"]["usd"])

# =========================
# 3) Load historical CSV (accepts RAW or PRETTY headings)
# =========================
def load_historical(path):
    df = pd.read_csv(path)

    # normalize date col name
    if "date" not in df.columns:
        if "Date" in df.columns:
            df = df.rename(columns={"Date": "date"})
        else:
            raise ValueError(f"Historical CSV must contain a 'date' (or 'Date') column. Columns: {list(df.columns)}")

    df["date"] = pd.to_datetime(df["date"]).dt.date

    # If user saved "pretty" columns, map back to raw internal names
    rename_map = {}
    if "Total MCAP" in df.columns and "total_mcap_usd" not in df.columns:
        rename_map["Total MCAP"] = "total_mcap_usd"
    if "Binance Assets" in df.columns and "binance_assets_usd" not in df.columns:
        rename_map["Binance Assets"] = "binance_assets_usd"
    if "Binance Market Share" in df.columns and "binance_market_share_pct" not in df.columns:
        rename_map["Binance Market Share"] = "binance_market_share_pct"
    if "Binance Market Share (%)" in df.columns and "binance_market_share_pct" not in df.columns:
        rename_map["Binance Market Share (%)"] = "binance_market_share_pct"

    # If you used "$bn" headings at some point
    if "Total MCAP ($bn)" in df.columns and "total_mcap_usd" not in df.columns:
        rename_map["Total MCAP ($bn)"] = "total_mcap_usd"
    if "Binance Assets ($bn)" in df.columns and "binance_assets_usd" not in df.columns:
        rename_map["Binance Assets ($bn)"] = "binance_assets_usd"

    if rename_map:
        df = df.rename(columns=rename_map)

    # Validate raw columns exist
    required = ["total_mcap_usd", "binance_assets_usd", "binance_market_share_pct"]
    missing = [c for c in required if c not in df.columns]
    if missing:
        raise ValueError(f"Missing column(s): {missing}. CSV columns are: {list(df.columns)}")

    # If numbers look like they were saved in billions, convert back to USD
    # (heuristic)
    if df["total_mcap_usd"].dropna().median() < 1e7:
        df["total_mcap_usd"] = df["total_mcap_usd"] * 1e9
    if df["binance_assets_usd"].dropna().median() < 1e7:
        df["binance_assets_usd"] = df["binance_assets_usd"] * 1e9

    # Ensure numeric types
    df["total_mcap_usd"] = pd.to_numeric(df["total_mcap_usd"], errors="coerce")
    df["binance_assets_usd"] = pd.to_numeric(df["binance_assets_usd"], errors="coerce")
    df["binance_market_share_pct"] = pd.to_numeric(df["binance_market_share_pct"], errors="coerce")

    # Drop completely empty rows
    df = df.dropna(subset=["date"]).sort_values("date").reset_index(drop=True)
    return df

# =========================
# 4) Upsert today's row
# =========================
def upsert_today(df_hist):
    today = datetime.utcnow().date()

    # If today exists already, do nothing
    if today in set(df_hist["date"].values):
        print("✅ Today already present — no update needed.")
        return df_hist

    print("🚀 Fetching today's data (DefiLlama + CoinGecko)...")
    binance_assets = get_binance_assets_today_defillama()
    time.sleep(0.3)  # polite pause
    total_mcap = get_total_crypto_mcap_today_coingecko()

    share_pct = (binance_assets / total_mcap) * 100

    new_row = pd.DataFrame({
        "date": [today],
        "total_mcap_usd": [total_mcap],
        "binance_assets_usd": [binance_assets],
        "binance_market_share_pct": [share_pct],
    })

    df_updated = pd.concat([df_hist, new_row], ignore_index=True)
    df_updated = df_updated.sort_values("date").reset_index(drop=True)
    print("✅ Added today's row")
    return df_updated

# =========================
# 5) Save RAW + PRETTY
# =========================
def save_outputs(df_raw):
    # RAW canonical (keep internal column names, USD)
    df_raw.to_csv(OUTPUT_RAW_CSV, index=False)

    # PRETTY (rename + billions)
    df_pretty = df_raw.copy()
    df_pretty = df_pretty.rename(columns={
        "total_mcap_usd": "Total MCAP",
        "binance_assets_usd": "Binance Assets",
        "binance_market_share_pct": "Binance Market Share",
    })

    # Convert to billions for display
    df_pretty["Total MCAP"] = (df_pretty["Total MCAP"] / 1e9).round(2)
    df_pretty["Binance Assets"] = (df_pretty["Binance Assets"] / 1e9).round(2)
    df_pretty["Binance Market Share"] = df_pretty["Binance Market Share"].round(3)

    df_pretty.to_csv(OUTPUT_PRETTY_CSV, index=False)

# =========================
# 6) Plot last N days + average line
# =========================
def plot_last_n_with_average(df_raw, days_to_plot=DAYS_TO_PLOT):
    df = df_raw.copy().sort_values("date").reset_index(drop=True)

    # keep only last N days (by rows/dates)
    if days_to_plot is not None and days_to_plot > 0 and len(df) > days_to_plot:
        df_plot = df.iloc[-days_to_plot:].copy()
    else:
        df_plot = df.copy()

    # compute average over the plotted period (ignore NaN)
    avg_pct = float(df_plot["binance_market_share_pct"].dropna().mean())
    # ===== today's deviation vs average =====
    today_pct = float(df_plot["binance_market_share_pct"].iloc[-1])

    # percentage point difference (BEST metric)
    diff_pp = today_pct - avg_pct

    # relative % difference
    diff_rel = (today_pct / avg_pct - 1) * 100

    plt.figure(figsize=(12, 6))
    plt.plot(df_plot["date"], df_plot["binance_market_share_pct"], label="Daily %")
    plt.axhline(
    avg_pct,
    linestyle="--",
    color="red",
    linewidth=2,
    label=f"Average ({avg_pct:.2f}%)"
)
    plt.title("Binance Market Share of Total Crypto Market Cap")
    plt.ylabel("% Share")
    plt.xlabel("Date")
    plt.grid(True)
    plt.legend()
    # format sign nicely
    sign_pp = "+" if diff_pp >= 0 else ""
    sign_rel = "+" if diff_rel >= 0 else ""

    annotation_text = (
        f"Today vs Avg: "
        f"{sign_pp}{diff_pp:.2f}pp "
        f"({sign_rel}{diff_rel:.1f}%)"
    )

    plt.text(
        0.01,
        0.88,
        annotation_text,
        transform=plt.gca().transAxes,
        fontsize=11,
        verticalalignment="top",
        bbox=dict(boxstyle="round,pad=0.3", alpha=0.15)
    )
    plt.tight_layout()
    plt.show()

    return df_plot, avg_pct

# =========================
# MAIN
# =========================
def main():
    print(f"Loading historical from: {HISTORICAL_CSV}")
    df_hist = load_historical(HISTORICAL_CSV)

    df_updated = upsert_today(df_hist)

    # Save outputs
    save_outputs(df_updated)
    print(f"✅ Wrote RAW:    {OUTPUT_RAW_CSV}")
    print(f"✅ Wrote PRETTY: {OUTPUT_PRETTY_CSV}")

    # Plot
    df_plot, avg_pct = plot_last_n_with_average(df_updated, DAYS_TO_PLOT)
    print(f"Average over plotted period: {avg_pct:.4f}%")

    # show tail in raw format
    print(df_updated.tail(10))
    return df_updated

# ---- RUN ----
df_updated = main()
